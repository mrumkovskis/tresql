//| mill-version: 1.1.0
//| mill-jvm-version: temurin:25
package build

import mill.*, scalalib.*

val scalaVersions = Seq("2.12.20", "2.13.17", "3.3.7")

object `package` extends Cross[TresqlModule](scalaVersions)

trait TresqlModule extends ProjectBaseModule {

  object core extends Cross[ProjectBaseModule](scalaVersions) {
    object test extends ScalaTests, TestModule.ScalaTest
  }
  object `macro` extends ScalaModule {
    def scalaVersion = crossScalaVersion
    def moduleDeps = Seq(core(crossScalaVersion))
    // Scala 2 only — macro uses whitebox macros not available in Scala 3
    override def allSourceFiles = Task {
      if (crossScalaVersion.startsWith("3")) Seq.empty[PathRef]
      else super.allSourceFiles()
    }
  }

  def moduleDeps = if (crossScalaVersion.startsWith("2")) Seq(`macro`) else Seq(core(crossScalaVersion))

  object test extends ProjectBaseTests {
    def moduleDeps = Seq(core.test)
  }

  object it extends ProjectBaseTests {
    def mvnDeps = Seq(mvn"org.postgresql:postgresql:42.7.8")
    def moduleDeps = Seq(core.test, test /*needs access to test/resources folder for tresql compilation*/)
  }
}

trait ProjectBaseModule extends CrossScalaModule {

  def jvmVersion = "temurin:11"

  def mvnDeps = Seq(mvn"org.scala-lang.modules::scala-parser-combinators:2.4.0") ++ (
    if (scalaVersion().startsWith("2")) Seq(mvn"org.scala-lang:scala-reflect:2.13.17")
    else Nil
  )

  def compileResources = Task.Sources("resources")

  def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-unchecked",
    "-language:dynamics",
    "-language:postfixOps",
    "-language:implicitConversions",
    "-language:reflectiveCalls",
    "-language:existentials"
  ) ++
    (scalaVersion() match {
      case v if v startsWith "3" => Seq("-explain")
      case _       => Seq()
    })

  trait ProjectBaseTests extends ScalaTests, TestModule.ScalaTest { self =>

    // Workaround: borer's Encoder/Decoder have Scala 3 inline methods referencing
    // io.bullet.borer.internal as a JVM type, but no such class file exists.
    // Mill's test discovery reflects on all classes and triggers NoClassDefFoundError.
    // A dummy class on the runtime classpath satisfies the JVM reflection.
    def borerWorkaround = Task.Source(moduleDir / os.up / "lib")
    override def runClasspath = Task {
      super.runClasspath() ++ Seq(borerWorkaround())
    }

    def mvnDeps = Task {
      def borerV = self.scalaVersion() match {
        case v if v startsWith "2.12" => "1.7.2"
        case v if v startsWith "2.13" => "1.8.0"
        case v if v startsWith "3"    => "1.16.2"
      }
      Seq(
        mvn"org.scalatest::scalatest:3.2.19",
        mvn"org.hsqldb:hsqldb:2.7.4",
        mvn"io.bullet::borer-core:$borerV",
        mvn"io.bullet::borer-derivation:$borerV",
      )
    }

    def compileResources = Task.Sources("resources")
    def testParallelism = true
  }
}
